  "repo.workspace.open": {
    "capability": "repo.workspace.open",
    "tool": "repo_workspace_open",
    "description": "Open a working copy of a repository (by name, or restored at a base commit with given files). Preparation (install, build) runs in the background.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ]
          }
        }
