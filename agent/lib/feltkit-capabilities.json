  "repo.changes.publish": {
    "capability": "repo.changes.publish",
    "tool": "repo_changes_publish",
    "description": "Publish the verified working copy: a deterministic commit on an eve/ branch and a pull request. A person approves it first. Never merges.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "expectTree": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace",
        "operation",
        "branch",
        "title",
        "body",
        "message",
        "expectTree"
      ]
    },
    "approval": "required"
  },
