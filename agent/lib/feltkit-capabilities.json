      "type": "object",
      "properties": {
        "workspace": {
          "type": "string"
        },
        "check": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "against": {
          "type": "string",
          "enum": [
            "change",
            "base"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "workspace",
        "check"
      ]
    },
